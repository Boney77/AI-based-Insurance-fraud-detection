# Set ONE of these on Vercel → Settings → Environment Variables → then REDEPLOY

# Option 1 (recommended):
RAILWAY_BACKEND_URL=https://your-app-name.up.railway.app

# Option 2 (also works):
VITE_API_URL=https://your-app-name.up.railway.app

# Rules:
# - Use your exact Railway URL
# - Must start with https://
# - NO trailing slash at the end
